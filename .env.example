DATA_MODE=live
DATABASE_URL=postgresql+asyncpg://arbitrage:arbitrage@postgres:5432/arbitrage
REDIS_URL=redis://redis:6379/0
MIN_NET_EDGE_PERCENT=0.03
MIN_LIQUIDITY=40
MAX_SLIPPAGE_PERCENT=0.25
MAX_PRICE_AGE_MS=5000
MAX_LATENCY_MS=1500
MAX_TRADE_SIZE=10000
TRADE_NOTIONAL=1000
MIN_CONFIDENCE_SCORE=60
STARTING_CAPITAL=100000
SNAPSHOT_INTERVAL_SECONDS=30
# Public market data only; no trading credentials accepted or needed.
# Live equities are disabled until a licensed depth provider is implemented.

# Optional local n8n; leave URL empty to use terminal-only events.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/arbitrage-x-events
AUTOMATION_TOKEN=replace-with-a-random-local-shared-token
AUTO_PAPER_TRADE=false
MIN_AUTO_EDGE=0.15
MIN_AUTO_CONFIDENCE=85
MAX_AUTO_CAPITAL=10000
MAX_DAILY_PAPER_TRADES=20
MAX_POSITION_NOTIONAL=25000
MAX_DRAWDOWN_PERCENT=15
EXECUTION_DELAY_MS=80
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Stripe subscriptions (server only). Start with test-mode credentials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_ALLOW_LIVE=false
BILLING_PUBLIC_URL=http://localhost:8080

# Server-side Kite credentials for Indian equity quote snapshots. Never put access tokens in frontend env.
KITE_API_KEY=
KITE_ACCESS_TOKEN=
