      "name": "Validate local token and event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const e=$json.body; const token=$json.headers['x-automation-token']; if (!$env.ARBITRAGE_AUTOMATION_TOKEN || token!==$env.ARBITRAGE_AUTOMATION_TOKEN) throw new Error('Invalid automation token'); if(e.event_type==='HIGH_CONFIDENCE_OPPORTUNITY'){const o=e.metadata;if(!(o.net_edge_percent>=0.15&&o.confidence_score>=85&&o.liquidity_score>=60))return [];} return [{json:e}];"
      }
    },
    {
      "id": "36902547-ca2f-4d39-b80f-32f57431c9d2",
      "name": "Local terminal notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ARBITRAGE_API_URL + '/automation/notify' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation-Token",
              "value": "={{ $env.ARBITRAGE_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 5000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    },
    {
      "id": "only-auto-opportunity",
      "name": "Only qualified opportunities",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
